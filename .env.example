# Snack Overflow configuration
# Copy to .env and fill in real values. Never commit .env.
# Everything below is a placeholder.

# --- Core -------------------------------------------------------------
# Public URL the app is served at (used for links in emails, push, OIDC callbacks)
APP_URL=https://snacks.example.com
# Port the app container listens on
PORT=3000
# Household time zone for best-before dates and notification times
TZ=Europe/London
# Long random string used to sign sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------
POSTGRES_USER=snackoverflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snackoverflow
# Used when running the server outside Docker (docker-compose.yml builds its own from the values above)
DATABASE_URL=postgres://snackoverflow:change-me@localhost:5432/snackoverflow

# --- First admin (created on first start if no users exist) -----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Admin
HOUSEHOLD_NAME=Our household
# Without ADMIN_EMAIL/ADMIN_PASSWORD the first visitor sets up the household in the browser.

# --- Sign-in with a self-hosted identity provider (optional) ----------
# Leave OIDC_ISSUER_URL empty to use built-in email + password only.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Single sign-on
# Allow built-in password login as well when OIDC is on
OIDC_ALLOW_PASSWORD_LOGIN=true

# --- Open Food Facts ---------------------------------------------------
# Identify the app politely to the Open Food Facts API
OFF_USER_AGENT=SnackOverflow/0.1 (admin@example.com)
OFF_BASE_URL=https://world.openfoodfacts.org
# Set to false to never look barcodes up online (unknown barcodes are then named by hand)
OFF_ENABLED=true
# Asked when Open Food Facts doesn't know a barcode (toiletries, cleaning, pet food). Comma-separated; empty for none.
OFF_SISTER_URLS=https://world.openproductsfacts.org,https://world.openpetfoodfacts.org,https://world.openbeautyfacts.org
# Optional: an Open Food Facts account (user name, not email) so people can add products they name.
# Leave empty to hide the option. Try it on the test server first with
# OFF_BASE_URL=https://off:off@world.openfoodfacts.net (it has its own accounts).
OFF_CONTRIBUTE_USER_ID=
OFF_CONTRIBUTE_PASSWORD=
# Where added products are sold (an Open Food Facts country tag); empty to leave it out
OFF_COUNTRY=en:united-kingdom

# --- Email (optional; needed for email notifications and invites) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Snack Overflow <snacks@example.com>"

# --- Web Push (optional; generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Android app ------------------------------------------------------------
# The Android app needs no push service: it checks the app's notification inbox
# in the background. Nothing to configure here.

# --- AI (optional; features hidden when empty) ------------------------
# Can also be set by an admin in Settings → AI and assistants (stored encrypted).
# Set here, these win over Settings.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# --- MCP endpoint (optional) -------------------------------------------
# Token assistants must send to use the MCP endpoint. Leave empty to disable it,
# or to make one in Settings → AI and assistants instead (set here, it wins).
MCP_TOKEN=

# --- Receipt import by email (optional, phase 4) ------------------------
# A mailbox the app checks for forwarded receipts and online-order emails.
# Leave RECEIPT_IMAP_HOST empty to disable email import (photo/upload still works).
RECEIPT_IMAP_HOST=
RECEIPT_IMAP_PORT=993
RECEIPT_IMAP_USER=
RECEIPT_IMAP_PASSWORD=
# Only accept forwarded receipts from these senders (comma-separated)
RECEIPT_ALLOWED_SENDERS=

# --- Pricing (optional, off by default) --------------------------------
# Starting value of the household's "Prices" switch; admins can change it in Settings.
PRICING_ENABLED=false
# Open Prices (crowd-sourced prices run by Open Food Facts), checked at most once a week per product
OPEN_PRICES_BASE_URL=https://prices.openfoodfacts.org

# --- Backups ------------------------------------------------------------
# Nightly pg_dump backups go here; leave empty to turn backups off (docker-compose.yml sets /backups)
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=14
# Time of day (household time zone, HH:MM) for the nightly backup
BACKUP_TIME=03:30

# --- Advanced ---------------------------------------------------------------
# Which env file docker-compose.yml loads into the app container (the test launcher uses .env.test)
APP_ENV_FILE=.env
# Turn off the built-in scheduler (notifications and backups), e.g. on a second replica
SCHEDULER_ENABLED=true
# Override where the seed CSVs and the built web app are read from (normally found automatically)
SEED_DATA_DIR=
WEB_DIST_DIR=
